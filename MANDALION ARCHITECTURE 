        "# Define Data Lake Root and construct the partition layers programmatically\n",
        "DATA_LAKE_ROOT = Path(CUSTOM_MOUNT) / \"MyDrive\" / \"CompanyDataLake\"\n",
        "BRONZE_PATH = DATA_LAKE_ROOT / \"bronze\"\n",
