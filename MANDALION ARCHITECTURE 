        "# ============================================================================\n",
        "# CELL 2: THE END-TO-END MEDALLION PIPELINE EXECUTIONS (FAIL-SAFE)\n",
        "# ============================================================================\n",
        "import json\n",
        "import requests\n",
        "import glob\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "from datetime import datetime\n",
        "# ------------------------------------------------------------\n",
        "# 1. BRONZE LAYER — RAW DATA INGESTION\n",
        "# ------------------------------------------------------------\n",
        "location = \"Nairobi\"\n",
        "latitude = -1.286389\n",
        "longitude = 36.817223\n",
        "url = (\n",
        " \"https://api.open-meteo.com/v1/forecast\"\n",
        " f\"?latitude={latitude}\"\n",
        " f\"&longitude={longitude}\"\n",
        " \"&past_days=30\"\n",
        " \"&forecast_days=0\"\n",
        " \"&hourly=temperature_2m,relative_humidity_2m,wind_speed_10m\"\n",
        ")\n",
        "print(\"[PHASE 2] Ingesting raw unstructured data stream to Bronze...\")\n",
        "response = requests.get(url)\n",
        "if response.status_code != 200:\n",
        " print(f\" API Server Error! Status Code: {response.status_code}\")\n",
        " print(f\"Server Response Content: {response.text}\")\n",
        " raise RuntimeError(\"The pipeline stopped because the API request failed.\")\n",
        "try:\n",
        " raw_payload = response.json()\n",
        "except Exception as e:\n",
        " print(\"Failed to interpret response as JSON!\")\n",
        " print(f\"What the server actually sent back:\\n{response.text}\")\n",
        " raise e\n",
        "pipeline_timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
        "bronze_file_path = BRONZE_PATH /f\"{location.lower()}_weather_raw_{pipeline_timestamp}.json\"\n",
        "with open(bronze_file_path, \"w\", encoding=\"utf-8\") as f:\n",
        " json.dump(raw_payload, f, indent=4)\n",
        " print(f\"✔ Raw JSON payload safely locked in Bronze:{bronze_file_path.name}\\n\")\n",
        "# ------------------------------------------------------------\n",
        "# 2. SILVER LAYER — COLUMNAR COMPRESSION & SCHEMA ENFORCEMENT\n",
        "# ------------------------------------------------------------\n",
        "print(\"[PHASE 3] Transforming raw schemas into optimized Silver Parquet...\")\n",
        "bronze_inventories = glob.glob(str(BRONZE_PATH / \"*_weather_raw_*.json\"))\n",
        "latest_bronze_file = max(bronze_inventories, key=Path).replace(\"\\\\\", \"/\")\n",
        "with open(latest_bronze_file, \"r\", encoding=\"utf-8\") as f:\n",
        " json_content = json.load(f)\n",
        "hourly_metrics = json_content[\"hourly\"]\n",
        "silver_df = pd.DataFrame({\n",
        " \"timestamp\": pd.to_datetime(hourly_metrics[\"time\"]),\n",
        " \"temperature_c\": pd.to_numeric(hourly_metrics[\"temperature_2m\"]),\n",
        " \"humidity_pct\": pd.to_numeric(hourly_metrics[\"relative_humidity_2m\"]),\n",
        " \"wind_speed_mps\": pd.to_numeric(hourly_metrics[\"wind_speed_10m\"])\n",
        "})\n",
        "silver_df[\"location\"], silver_df[\"processed_at\"] = location,pd.Timestamp.now()\n",
        "silver_df = silver_df[[\"timestamp\",\"location\",\"temperature_c\",\"humidity_pct\",\"wind_speed_mps\",\"processed_at\"]]\n",
        "silver_file_path = SILVER_PATH /f\"{location.lower()}_weather_clean_{pipeline_timestamp}.parquet\"\n",
        "silver_df.to_parquet(silver_file_path, index=False, compression=\"snappy\")\n",
        "print(f\"Columnar Parquet file written to Silver: {silver_file_path.name}\\n\")\n",
        "# ------------------------------------------------------------\n",
        "# 3. GOLD LAYER — BUSINESS STOREFRONT ROLLS-UPS\n",
        "# ------------------------------------------------------------\n",
        "print(\"[PHASE 4] Executing Gold aggregated roll-ups for reporting...\")\n",
        "parquet_df = pd.read_parquet(silver_file_path)\n",
        "parquet_df[\"date\"] = parquet_df[\"timestamp\"].dt.date\n",
        "gold_df = parquet_df.groupby([\"date\", \"location\"]).agg(\n",
        " avg_temperature_c=(\"temperature_c\", \"mean\"),\n",
        " max_temperature_c=(\"temperature_c\", \"max\"),\n",
        " min_temperature_c=(\"temperature_c\", \"min\"),\n",
        " avg_humidity_pct=(\"humidity_pct\", \"mean\"),\n",
        " max_wind_speed_mps=(\"wind_speed_mps\", \"max\"),\n",
        " total_data_points=(\"timestamp\", \"count\")\n",
        ").reset_index()\n",
        "numerical_cols = [\"avg_temperature_c\", \"max_temperature_c\",\n",
        "\"min_temperature_c\", \"avg_humidity_pct\", \"max_wind_speed_mps\"]\n",
        "gold_df[numerical_cols] = gold_df[numerical_cols].round(2)\n",
        "gold_file_path = GOLD_PATH / f\"daily_weather_summary_{pipeline_timestamp}.csv\"\n",
        "gold_df.to_csv(gold_file_path, index=False)\n",
        "print(f\"Final dashboard-ready CSV table committed to Gold:{gold_file_path.name}\\n\")\n",
        "print(\"PIPELINE RUN EXECUTED SUCCESSFULLY COMPLETED\")"
      ],
